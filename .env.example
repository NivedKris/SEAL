# Copy to .env for local runs. On Vercel, add the same names under
# Project → Settings → Environment Variables (Production, Preview, Development).

# Groq — primary AI provider (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini — fallback AI provider (https://aistudio.google.com/apikey)
# Either name works; GEMINI_API_KEY is preferred.
GEMINI_API_KEY=

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=

# Database name (optional, defaults to "seal")
MONGODB_DB=seal

# Assistant (chat + live voice). Use a separate Google project / Groq organisation so voice sessions
# can't use up the limits SEAL's claim checks need. Optional: falls back to the keys above.
# GOOGLE_API_KEY_2 and GROQ_API_KEY2 are accepted as the same thing.
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_GROQ_API_KEY=
